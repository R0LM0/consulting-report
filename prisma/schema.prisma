// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())
  activities   Activity[]
  receipts     Receipt[]

  // Billing defaults, editable in /perfil so the receipt form pre-fills
  // them. montoSubtotal only changes when the contract does;
  // receiptNextNumber seeds the automatic receipt counter the first time
  // (after that it comes from the Receipt records themselves).
  defaultMontoSubtotal Float?
  receiptNextNumber    Int?
}

model Activity {
  id          String   @id @default(cuid())
  // Calendar day the activity happened - no time-of-day meaning. Stored as
  // a plain SQL date (UTC midnight) so it round-trips without timezone
  // drift regardless of where the app or DB run.
  date        DateTime @db.Date
  description String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

// Every receipt generated through /api/reportes/recibo is recorded here.
// One per user/month (upserted), which powers the automatic "next numero"
// suggestion: max(numero of the year) + 1.
model Receipt {
  id            String   @id @default(cuid())
  numero        Int
  anio          Int
  mes           Int
  montoSubtotal Float
  fecha         DateTime @db.Date
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())

  @@unique([userId, anio, mes])
  @@index([userId, anio])
}
