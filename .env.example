# Postgres connection string (Neon). Get this from your Neon project dashboard
# after creating a database — Neon > Project > Connection Details.
# Example shape: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (non-pooled) connection string used by Prisma CLI for migrations.
# On Neon: same as DATABASE_URL but without the "-pooler" host suffix.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js (NextAuth v5) secret used to sign/encrypt session JWTs.
# Generate one with: npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

# Used only by prisma/seed.ts to create the single application user.
# Set real values before running the seed script.
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="change-me"
SEED_USER_NAME="Your Name"
